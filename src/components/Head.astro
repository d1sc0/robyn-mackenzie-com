---
import { SEO } from 'astro-seo';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: {
    publishedTime?: string;
    tags?: string[];
  };
}

const {
  title: propTitle,
  description: propDescription,
  ogImage: propOgImage,
  article,
} = Astro.props;

const siteURL = Astro.site?.toString() || 'https://robynmackenzie.com/';
const canonicalURL = new URL(Astro.url.pathname, siteURL).toString();

const siteName = 'Robyn Mackenzie';
const defaultDescription = "Designer and user researcher driven by a belief that better services build a better world. Specialising in service design, digital transformation, and content design.";
const description = propDescription || defaultDescription;

const pageTitle = propTitle ? `${propTitle} | ${siteName}` : `${siteName} — Designer & User Researcher`;
const defaultOgImage = new URL('/src/assets/images/robyn-portrait.png', siteURL).toString();
const ogImage = propOgImage || defaultOgImage;

// Schema.org Person metadata
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Robyn Mackenzie',
  url: siteURL,
  jobTitle: 'Designer & User Researcher',
  alumniOf: 'Arts University Bournemouth',
  description: description,
  sameAs: [
    'https://www.linkedin.com/in/robyn-mackenzie/',
    'https://robynmackenzie.framer.website/'
  ]
};

const jsonLd = article ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: propTitle || siteName,
  description: description,
  datePublished: article.publishedTime,
  author: personSchema,
  url: canonicalURL,
} : personSchema;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <link rel="icon" type="image/png" href="/favicon-light.png" media="(prefers-color-scheme: light)" />
  <link rel="icon" type="image/png" href="/favicon-dark.png" media="(prefers-color-scheme: dark)" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS Feed`} href="/rss.xml" />
  
  <meta name="generator" content={Astro.generator} />
  
  <SEO
    title={pageTitle}
    description={description}
    openGraph={{
      basic: {
        title: pageTitle,
        type: article ? 'article' : 'website',
        image: ogImage,
      },
      optional: {
        description: description,
        siteName: siteName,
      },
      article: article ? {
        publishedTime: article.publishedTime,
        tags: article.tags,
      } : undefined,
    }}
    twitter={{
      card: 'summary_large_image',
      title: pageTitle,
      description: description,
      image: ogImage,
    }}
  />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
